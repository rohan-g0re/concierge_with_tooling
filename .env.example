# ── Compass Concierge — environment variables template ──
# Copy this file to .env in the project root (or backend/ for the backend process)
# and fill in real values. Never commit the real .env.

# ── LLM Keys ──
# Text orchestrator: Gemini (google-genai SDK v2.x GA)
GEMINI_API_KEY=your_gemini_api_key_here

# Voice: OpenAI GPT Realtime (ephemeral token minting)
OPENAI_API_KEY=your_openai_api_key_here

# ── Backend (optional overrides) ──
# Comma-separated list of allowed CORS origins (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Debug ──
# DEBUG=false
